{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "om-governance-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["GovernanceRuntimeState"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GOVERNANCE_STATE",
        "class_name": "GovernanceRuntimeState"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
