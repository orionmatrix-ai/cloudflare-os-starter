{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "knowledge-snapshot-candidate",
  "main": ".wrangler/validate/src/index.ts",
  "build": { "command": "node build-ui.mjs && pnpm exec capnweb-validate build --out .wrangler/validate", "watch_dir": "src" },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "allow_irrevocable_stub_storage"],
  "migrations": [{ "tag": "knowledge-pilot-v1", "new_sqlite_classes": ["KnowledgePilotLedger"] }],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": { "KNOWLEDGE_ENABLED": "false", "KNOWLEDGE_GATEWAY_ENABLED": "false" },
  "limits": { "cpu_ms": 50 },
  "observability": { "enabled": false }
}
